{
  "name": "purchase-order-ai-assistant",
  "version": "1.0.0",
  "description": "Open source demo: a purchase order AI assistant using Claude tool calling over a read-only Postgres with fake data",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "chat": "tsx scripts/chat.ts",
    "eval": "tsx evals/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyank8141/purchase-order-ai-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/priyank8141/purchase-order-ai-assistant/issues"
  },
  "homepage": "https://github.com/priyank8141/purchase-order-ai-assistant#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "private": true
}
