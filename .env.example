# --- Claude ---
ANTHROPIC_API_KEY=
# Model is read from env, never hardcoded in code.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Database ---
# App connection: owns the schema, writes conversations/messages/traces.
DATABASE_URL=postgres://po_app:po_app_password@localhost:5433/po_assistant
# Agent connection: SELECT-only on suppliers, purchase_orders, po_items, payments.
# `npm run db:migrate` creates this role using the user/password in this URL.
DATABASE_URL_READONLY=postgres://agent_readonly:agent_readonly_password@localhost:5433/po_assistant

# --- Demo settings ---
# Fixed "today" so seed data, "this quarter", and evals are reproducible.
DEMO_TODAY=2026-11-15
# Single currency for all amounts (stored as integer cents).
DEMO_CURRENCY=USD

# --- Claude tuning (optional) ---
# Thinking depth: low | medium | high | xhigh | max. Opus 5.5 defaults to medium.
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback ("default" lets the API pick a fallback model; "off" disables).
ANTHROPIC_REFUSAL_FALLBACK=default
